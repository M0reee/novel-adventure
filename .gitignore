# 世界库（含小说原文切块、私有设定、玩家存档），默认不应提交公共仓库
worlds/*

# 允许提交经过瘦身的公开试玩预设；不得包含 chunks/facts/source_index 原文数据
!worlds/doupo_cangqiong/
!worlds/doupo_cangqiong/*.json
!worlds/doupo_cangqiong/*.jsonl
!worlds/doupo_cangqiong/*.md
!worlds/doupo_cangqiong/retrieval.sqlite
worlds/doupo_cangqiong/chunks.jsonl
worlds/doupo_cangqiong/facts.jsonl
worlds/doupo_cangqiong/source_index.jsonl
worlds/doupo_cangqiong/llm_requests.jsonl
worlds/doupo_cangqiong/llm_responses.jsonl
worlds/doupo_cangqiong/llm_facts_cache.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# 操作系统/编辑器噪音
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 日志/数据文件
*.log
*.sqlite
*.sqlite-journal
!worlds/doupo_cangqiong/retrieval.sqlite
